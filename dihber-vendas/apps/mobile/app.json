{
  "expo": {
    "name": "DihberVendas",
    "slug": "dihber-vendas",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dihbervendas",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.dihber.vendas",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.dihber.vendas",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://192.168.0.10:3333/api/v1"
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
